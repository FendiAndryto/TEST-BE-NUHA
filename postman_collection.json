            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"siti.aminah\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Menguji Kriteria #1: Login single role langsung mendapatkan accessToken resmi."
          }
        },
        {
          "name": "1.4 Login - Super Admin (admin)",
          "event": [
            {
              "listen": "test",
