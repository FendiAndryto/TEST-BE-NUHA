{
  "info": {
    "_postman_id": "nuha-backend-assessment-2026",
    "name": "PT Data Integrasi Inovasi (NUHA) - Access & Menu Management API",
    "description": "Koleksi API untuk Uji Coba Interview Backend Developer PT Data Integrasi Inovasi.\nModul Login, Jabatan Ganda (Dual Role), Menu Bersarang Tanpa Batas, dan Access Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "preAuthToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login - Dual Role (budi.santoso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.preAuthToken) {",
                  "    pm.collectionVariables.set('preAuthToken', jsonData.preAuthToken);",
                  "    console.log('Saved preAuthToken:', jsonData.preAuthToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"budi.santoso\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Menguji Kriteria #2: Sistem merespons dengan requiresRoleSelection=true dan preAuthToken."
          }
        },
        {
          "name": "1.2 Select Role (Jabatan Ganda)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    console.log('Saved accessToken:', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preAuthToken\": \"{{preAuthToken}}\",\n  \"roleId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/select-role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "select-role"]
            },
            "description": "Menyelesaikan proses login dual-role dengan memilih Role ID 2 (Manager Operasional) atau 3 (Supervisor)."
          }
        },
        {
          "name": "1.3 Login - Single Role (siti.aminah)",
